# Installed dependencies (including npm workspace-local installs).
node_modules/

# Reproducible native/browser build output and local caches/state.
target/
/dist/
/.tora/
/.data/
/.cache/
*.tsbuildinfo

# Local reports and scratch artifacts stay outside source snapshots.
/reports/
/tmp/
/scratch/

# Python execution and root-local virtual environments.
__pycache__/
*.py[cod]
/.venv/
/venv/

# Browser recordings, profiles and coverage generated by local test runners.
/playwright-report/
/test-results/
/blob-report/
/coverage/
/.nyc_output/

# Local secrets; sanitized templates can be versioned and must pass the secret audit.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx

# Package-manager diagnostics and OS metadata.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
